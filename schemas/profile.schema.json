{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sauljabin/kantrip/main/schemas/profile.schema.json",
  "title": "Kantrip plaintext profile",
  "$ref": "#/$defs/profile",
  "$defs": {
    "clientProperties": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean"]
      }
    },
    "noneAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "none"
        }
      }
    },
    "kafka": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrapServers", "transport", "auth"],
      "properties": {
        "bootstrapServers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:\\[[0-9A-Fa-f:]+\\]|[^\\s,:]+):[0-9]{1,5}$"
          }
        },
        "transport": {
          "const": "plaintext"
        },
        "auth": {
          "$ref": "#/$defs/noneAuth"
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "common": {
              "$ref": "#/$defs/clientProperties"
            },
            "java": {
              "$ref": "#/$defs/clientProperties"
            },
            "librdkafka": {
              "$ref": "#/$defs/clientProperties"
            }
          }
        }
      }
    },
    "registryUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^http://(?:\\[[0-9A-Fa-f:]+\\]|[^\\s/?#@:]+)(?::[0-9]{1,5})?(?:/[^\\s?#]*)?$"
    },
    "registry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "schema.registry.url"],
          "properties": {
            "provider": {
              "const": "confluent"
            },
            "schema.registry.url": {
              "$ref": "#/$defs/registryUrl"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "apicurio.registry.url"],
          "properties": {
            "provider": {
              "const": "apicurio"
            },
            "apicurio.registry.url": {
              "$ref": "#/$defs/registryUrl"
            }
          }
        }
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kafka"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "description": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9._-]+$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "kafka": {
          "$ref": "#/$defs/kafka"
        },
        "registry": {
          "$ref": "#/$defs/registry"
        }
      }
    }
  }
}
