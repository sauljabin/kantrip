{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sauljabin/kantrip/main/schemas/profile.schema.json",
  "title": "Kantrip profile",
  "$ref": "#/$defs/profile",
  "$defs": {
    "noneAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "none"
        }
      }
    },
    "secretReference": {
      "type": "string",
      "pattern": "^profile/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/(?:kafka/password|kafka/oauth/client-secret|kafka/tls/private-key|kafka/tls/private-key-password|registry/password|registry/token|registry/oauth/client-secret)$"
    },
    "passwordAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "username", "passwordRef"],
      "properties": {
        "type": {
          "enum": ["plain", "scram-sha-256", "scram-sha-512"]
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "passwordRef": {
          "allOf": [
            { "$ref": "#/$defs/secretReference" },
            { "pattern": "/kafka/password$" }
          ]
        }
      }
    },
    "mtlsAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "clientCertificate", "privateKeyRef"],
      "properties": {
        "type": {
          "const": "mtls"
        },
        "clientCertificate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576,
          "pattern": "^-----BEGIN CERTIFICATE-----"
        },
        "privateKeyRef": {
          "allOf": [
            { "$ref": "#/$defs/secretReference" },
            { "pattern": "/kafka/tls/private-key$" }
          ]
        },
        "privateKeyPasswordRef": {
          "allOf": [
            { "$ref": "#/$defs/secretReference" },
            { "pattern": "/kafka/tls/private-key-password$" }
          ]
        }
      }
    },
    "kafkaTls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caCertificates": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576,
          "pattern": "^-----BEGIN CERTIFICATE-----"
        }
      }
    },
    "kafka": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrapServers", "transport", "auth"],
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "const": "plaintext"
              }
            }
          },
          "then": {
            "not": {
              "required": ["tls"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "auth": {
                "properties": {
                  "type": {
                    "enum": ["plain", "scram-sha-256", "scram-sha-512", "mtls"]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "transport": {
                "const": "tls"
              }
            }
          }
        }
      ],
      "properties": {
        "bootstrapServers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:\\[[0-9A-Fa-f:]+\\]|[^\\s,:]+):[0-9]{1,5}$"
          }
        },
        "transport": {
          "enum": ["plaintext", "tls"]
        },
        "auth": {
          "oneOf": [
            { "$ref": "#/$defs/noneAuth" },
            { "$ref": "#/$defs/passwordAuth" },
            { "$ref": "#/$defs/mtlsAuth" }
          ]
        },
        "tls": {
          "$ref": "#/$defs/kafkaTls"
        }
      }
    },
    "registryUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^http://(?:\\[[0-9A-Fa-f:]+\\]|[^\\s/?#@:]+)(?::[0-9]{1,5})?(?:/[^\\s?#]*)?$"
    },
    "registry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "schema.registry.url"],
          "properties": {
            "provider": {
              "const": "confluent"
            },
            "schema.registry.url": {
              "$ref": "#/$defs/registryUrl"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "apicurio.registry.url"],
          "properties": {
            "provider": {
              "const": "apicurio"
            },
            "apicurio.registry.url": {
              "$ref": "#/$defs/registryUrl"
            }
          }
        }
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kafka"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "description": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9._-]+$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "kafka": {
          "$ref": "#/$defs/kafka"
        },
        "registry": {
          "$ref": "#/$defs/registry"
        }
      }
    }
  }
}
