{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sauljabin/kantrip/main/schemas/profile.schema.json",
  "title": "Kantrip plaintext profile configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["profiles"],
  "properties": {
    "profiles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[^/\\\\\\u0000]{1,128}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "clientProperties": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean"]
      }
    },
    "noneAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "none"
        }
      }
    },
    "kafka": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrapServers", "transport", "auth"],
      "properties": {
        "bootstrapServers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:\\[[0-9A-Fa-f:]+\\]|[^\\s,:]+):[0-9]{1,5}$"
          }
        },
        "transport": {
          "const": "plaintext"
        },
        "auth": {
          "$ref": "#/$defs/noneAuth"
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "common": {
              "$ref": "#/$defs/clientProperties"
            },
            "java": {
              "$ref": "#/$defs/clientProperties"
            },
            "librdkafka": {
              "$ref": "#/$defs/clientProperties"
            }
          }
        }
      }
    },
    "schemaRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "auth"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "transport": {
          "enum": ["plaintext", "tls"]
        },
        "auth": {
          "oneOf": [
            {
              "$ref": "#/$defs/noneAuth"
            },
            {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "enum": ["basic", "bearer"]
                }
              }
            }
          ]
        },
        "tls": {
          "type": ["object", "boolean"]
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kafka"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "description": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9._-]+$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "kafka": {
          "$ref": "#/$defs/kafka"
        },
        "schemaRegistry": {
          "$ref": "#/$defs/schemaRegistry"
        }
      }
    }
  }
}
