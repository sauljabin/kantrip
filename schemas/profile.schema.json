{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sauljabin/kantrip/main/schemas/profile.schema.json",
  "title": "Kantrip profile",
  "$ref": "#/$defs/profile",
  "$defs": {
    "noneAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "none"
        }
      }
    },
    "secretReference": {
      "type": "string",
      "pattern": "^profile/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/(?:kafka/password|kafka/oauth/client-secret|kafka/tls/private-key|kafka/tls/private-key-password|registry/password|registry/token|registry/oauth/client-secret|registry/tls/private-key|registry/tls/private-key-password)$"
    },
    "passwordAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "username", "passwordRef"],
      "properties": {
        "type": {
          "enum": ["plain", "scram-sha-256", "scram-sha-512"]
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "passwordRef": {
          "allOf": [
            { "$ref": "#/$defs/secretReference" },
            { "pattern": "/kafka/password$" }
          ]
        }
      }
    },
    "mtlsAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "clientCertificate", "privateKeyRef"],
      "properties": {
        "type": {
          "const": "mtls"
        },
        "clientCertificate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576,
          "pattern": "^-----BEGIN CERTIFICATE-----"
        },
        "privateKeyRef": {
          "allOf": [
            { "$ref": "#/$defs/secretReference" },
            { "pattern": "/kafka/tls/private-key$" }
          ]
        },
        "privateKeyPasswordRef": {
          "allOf": [
            { "$ref": "#/$defs/secretReference" },
            { "pattern": "/kafka/tls/private-key-password$" }
          ]
        }
      }
    },
    "kafkaTls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caCertificates": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576,
          "pattern": "^-----BEGIN CERTIFICATE-----"
        }
      }
    },
    "kafka": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrapServers", "transport", "auth"],
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "const": "plaintext"
              }
            }
          },
          "then": {
            "not": {
              "required": ["tls"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "auth": {
                "properties": {
                  "type": {
                    "enum": ["plain", "scram-sha-256", "scram-sha-512", "mtls"]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "transport": {
                "const": "tls"
              }
            }
          }
        }
      ],
      "properties": {
        "bootstrapServers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:\\[[0-9A-Fa-f:]+\\]|[^\\s,:]+):[0-9]{1,5}$"
          }
        },
        "transport": {
          "enum": ["plaintext", "tls"]
        },
        "auth": {
          "oneOf": [
            { "$ref": "#/$defs/noneAuth" },
            { "$ref": "#/$defs/passwordAuth" },
            { "$ref": "#/$defs/mtlsAuth" }
          ]
        },
        "tls": {
          "$ref": "#/$defs/kafkaTls"
        }
      }
    },
    "registryUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://(?:\\[[0-9A-Fa-f:]+\\]|[^\\s/?#@:]+)(?::[0-9]{1,5})?(?:/[^\\s?#]*)?$"
    },
    "registryTls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caCertificates": { "$ref": "#/$defs/kafkaTls/properties/caCertificates" },
        "clientCertificate": { "$ref": "#/$defs/mtlsAuth/properties/clientCertificate" }
      }
    },
    "registryAuth": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "none" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "username", "passwordRef"], "properties": { "type": { "const": "basic" }, "username": { "type": "string", "minLength": 1 }, "passwordRef": { "allOf": [{ "$ref": "#/$defs/secretReference" }, { "pattern": "/registry/password$" }] } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "tokenRef"], "properties": { "type": { "const": "token" }, "tokenRef": { "allOf": [{ "$ref": "#/$defs/secretReference" }, { "pattern": "/registry/token$" }] } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "privateKeyRef"], "properties": { "type": { "const": "mtls" }, "privateKeyRef": { "allOf": [{ "$ref": "#/$defs/secretReference" }, { "pattern": "/registry/tls/private-key$" }] }, "privateKeyPasswordRef": { "allOf": [{ "$ref": "#/$defs/secretReference" }, { "pattern": "/registry/tls/private-key-password$" }] } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "tokenUrl", "clientId", "scopes", "clientSecretRef"], "properties": { "type": { "const": "oauth" }, "tokenUrl": { "type": "string", "pattern": "^https://" }, "clientId": { "type": "string", "minLength": 1 }, "scopes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "clientSecretRef": { "allOf": [{ "$ref": "#/$defs/secretReference" }, { "pattern": "/registry/oauth/client-secret$" }] }, "caCertificates": { "$ref": "#/$defs/kafkaTls/properties/caCertificates" }, "logicalCluster": { "type": "string", "minLength": 1 }, "identityPoolId": { "type": "string", "minLength": 1 } } }
      ]
    },
    "registry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "schema.registry.url"],
          "properties": {
            "provider": {
              "const": "confluent"
            },
            "schema.registry.url": {
              "$ref": "#/$defs/registryUrl"
            },
            "tls": { "$ref": "#/$defs/registryTls" },
            "auth": { "$ref": "#/$defs/registryAuth" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "apicurio.registry.url"],
          "properties": {
            "provider": {
              "const": "apicurio"
            },
            "apicurio.registry.url": {
              "$ref": "#/$defs/registryUrl"
            },
            "tls": { "$ref": "#/$defs/registryTls" },
            "auth": { "$ref": "#/$defs/registryAuth" }
          }
        }
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kafka"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "description": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9._-]+$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "kafka": {
          "$ref": "#/$defs/kafka"
        },
        "registry": {
          "$ref": "#/$defs/registry"
        }
      }
    }
  }
}
