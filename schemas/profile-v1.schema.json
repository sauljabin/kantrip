{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sauljabin/kantrip/main/schemas/profile-v1.schema.json",
  "title": "Kantrip profile configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profiles"],
  "properties": {
    "version": {
      "const": 1
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "staleSessionTtl": {
          "type": "string",
          "pattern": "^[1-9][0-9]*[smhd]$",
          "default": "15m"
        }
      }
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[^/\\\\\\u0000]{1,128}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "$defs": {
    "credentialRef": {
      "type": "string",
      "pattern": "^keyring://profile/[0-9a-fA-F-]{36}/[a-z0-9-]+(?:/[a-z0-9-]+)*$"
    },
    "clientProperties": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean"]
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caRef": {
          "$ref": "#/$defs/credentialRef"
        },
        "serverName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "registryTls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caRef": {
          "$ref": "#/$defs/credentialRef"
        },
        "serverName": {
          "type": "string",
          "minLength": 1
        },
        "certificateRef": {
          "$ref": "#/$defs/credentialRef"
        },
        "privateKeyRef": {
          "$ref": "#/$defs/credentialRef"
        },
        "privateKeyPasswordRef": {
          "$ref": "#/$defs/credentialRef"
        }
      }
    },
    "noneAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "none"
        }
      }
    },
    "plainAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "username", "passwordRef"],
      "properties": {
        "type": {
          "const": "plain"
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "passwordRef": {
          "$ref": "#/$defs/credentialRef"
        }
      }
    },
    "scramAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mechanism", "username", "passwordRef"],
      "properties": {
        "type": {
          "const": "scram"
        },
        "mechanism": {
          "enum": ["SCRAM-SHA-256", "SCRAM-SHA-512"]
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "passwordRef": {
          "$ref": "#/$defs/credentialRef"
        }
      }
    },
    "mtlsAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "certificateRef", "privateKeyRef"],
      "properties": {
        "type": {
          "const": "mtls"
        },
        "certificateRef": {
          "$ref": "#/$defs/credentialRef"
        },
        "privateKeyRef": {
          "$ref": "#/$defs/credentialRef"
        },
        "privateKeyPasswordRef": {
          "$ref": "#/$defs/credentialRef"
        }
      }
    },
    "oauthAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "provider", "tokenEndpoint", "clientId", "clientSecretRef"],
      "properties": {
        "type": {
          "const": "oauth"
        },
        "provider": {
          "enum": ["generic", "strimzi"]
        },
        "tokenEndpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "clientId": {
          "type": "string",
          "minLength": 1
        },
        "clientSecretRef": {
          "$ref": "#/$defs/credentialRef"
        },
        "scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "tls": {
          "$ref": "#/$defs/tls"
        },
        "java": {
          "type": "object",
          "additionalProperties": false,
          "required": ["callbackJar", "callbackClass"],
          "properties": {
            "callbackJar": {
              "type": "string",
              "minLength": 1
            },
            "callbackClass": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "mskIamAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "region", "credentialSource", "java"],
      "properties": {
        "type": {
          "const": "mskIam"
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "credentialSource": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {
                "type": {
                  "const": "environment"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "profile"],
              "properties": {
                "type": {
                  "const": "awsVault"
                },
                "profile": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "java": {
          "type": "object",
          "additionalProperties": false,
          "required": ["callbackJar", "mechanism"],
          "properties": {
            "callbackJar": {
              "type": "string",
              "minLength": 1
            },
            "mechanism": {
              "const": "AWS_MSK_IAM"
            }
          }
        }
      }
    },
    "auth": {
      "oneOf": [
        {
          "$ref": "#/$defs/noneAuth"
        },
        {
          "$ref": "#/$defs/plainAuth"
        },
        {
          "$ref": "#/$defs/scramAuth"
        },
        {
          "$ref": "#/$defs/mtlsAuth"
        },
        {
          "$ref": "#/$defs/oauthAuth"
        },
        {
          "$ref": "#/$defs/mskIamAuth"
        }
      ]
    },
    "kafka": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrapServers", "transport", "auth"],
      "properties": {
        "bootstrapServers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:\\[[0-9A-Fa-f:]+\\]|[^\\s,:]+):[0-9]{1,5}$"
          }
        },
        "transport": {
          "enum": ["plaintext", "tls"]
        },
        "auth": {
          "$ref": "#/$defs/auth"
        },
        "tls": {
          "$ref": "#/$defs/tls"
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "common": {
              "$ref": "#/$defs/clientProperties"
            },
            "java": {
              "$ref": "#/$defs/clientProperties"
            },
            "librdkafka": {
              "$ref": "#/$defs/clientProperties"
            }
          }
        }
      }
    },
    "registryAuth": {
      "oneOf": [
        {
          "$ref": "#/$defs/noneAuth"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "username", "passwordRef"],
          "properties": {
            "type": {
              "const": "basic"
            },
            "username": {
              "type": "string",
              "minLength": 1
            },
            "passwordRef": {
              "$ref": "#/$defs/credentialRef"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "tokenRef"],
          "properties": {
            "type": {
              "const": "bearer"
            },
            "tokenRef": {
              "$ref": "#/$defs/credentialRef"
            }
          }
        }
      ]
    },
    "schemaRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "auth"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "auth": {
          "$ref": "#/$defs/registryAuth"
        },
        "tls": {
          "$ref": "#/$defs/registryTls"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kafka"],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "description": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9._-]+$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "kafka": {
          "$ref": "#/$defs/kafka"
        },
        "schemaRegistry": {
          "$ref": "#/$defs/schemaRegistry"
        }
      }
    }
  }
}
